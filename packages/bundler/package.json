{
  "name": "@onveloz/pulse-bundler",
  "version": "0.1.3",
  "type": "module",
  "license": "MIT",
  "description": "Vite-based bundler preset for Pulse apps — definePulseApp() configures React, SSE-safe dev server, and SDK resolution in one line.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "peerDependencies": {
    "vite": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PierreAndreis/pulse.git",
    "directory": "packages/bundler"
  },
  "homepage": "https://github.com/PierreAndreis/pulse#readme",
  "bugs": {
    "url": "https://github.com/PierreAndreis/pulse/issues"
  },
  "author": "Pierre Ortega",
  "devDependencies": {
    "@onveloz/pulse-tsconfig": "workspace:*",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.15"
  }
}

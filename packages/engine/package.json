{
  "name": "@onveloz/pulse-engine",
  "version": "0.1.3",
  "type": "module",
  "license": "MIT",
  "description": "Downloads and resolves the Pulse reactivity engine (pulse-server) binary for the host platform.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "checksums.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PierreAndreis/pulse.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/PierreAndreis/pulse#readme",
  "bugs": {
    "url": "https://github.com/PierreAndreis/pulse/issues"
  },
  "author": "Pierre Ortega",
  "devDependencies": {
    "@onveloz/pulse-tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}

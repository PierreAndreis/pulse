{
  "name": "pulse-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pulse dev app/app.ts --start vite",
    "build": "tsc && vite build",
    "start:engine": "pulse dev app/app.ts",
    "gen": "pulse gen app/schema.ts",
    "migrate": "pulse migrate app/schema.ts --out schema.sql",
    "db": "docker compose up -d",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@onveloz/pulse-client": "^0.1.5",
    "@onveloz/pulse-contract": "^0.1.5",
    "@onveloz/pulse-react": "^0.1.5",
    "@onveloz/pulse-schema": "^0.1.5",
    "@onveloz/pulse-server": "^0.1.5",
    "perfect-freehand": "^1.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@onveloz/pulse-bundler": "^0.1.5",
    "@onveloz/pulse-cli": "^0.1.5",
    "@onveloz/pulse-engine": "^0.1.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.15"
  }
}

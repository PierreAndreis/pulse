{
  "name": "pulse-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Pulse — a reactive, local-first application platform on Postgres (Rust engine + TypeScript SDK).",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:load": "vitest run --config vitest.load.config.ts",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache .tsbuildinfo"
  },
  "devDependencies": {
    "@onveloz/pulse-client": "workspace:*",
    "@onveloz/pulse-contract": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0",
    "yjs": "^13.6.31"
  }
}
